# ==============================================================
# 《落叶物语》前端环境变量模板
#
# 使用方法：复制本文件为 .env（Windows: copy .env.example .env），
# 填入你自己 Supabase 项目的值，然后重启 npm run dev。
#
# 安全红线：
# - 这里只能放「可公开的客户端 Key」（anon public key）。
# - 绝对不要把 service_role key 或任何私密 API Key 写进前端环境变量。
# - .env 已被 .gitignore 忽略，不会提交到仓库。
# ==============================================================

# Supabase 项目 URL
# 获取位置：Supabase Dashboard → Project Settings → API → Project URL
# 形如 https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase 匿名公钥（anon public）
# 获取位置：Supabase Dashboard → Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=
